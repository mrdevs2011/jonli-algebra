  "doska": {
    "intro": "Kitobdagi 26-§ — masalalar va namunalar tahlili.",
    "masalalar": [
      {
        "caption": "1-masala · sin870° va cos870° · 130-bet",
        "kirish": "870° ni to'la aylanishlar 2·360° + 150° ga ajratamiz.",
        "img": "png/1-masala.png",
        "alt": "1-masala: sin870 va cos870 hisoblash, 130-bet",
        "width": 640,
        "height": 270,
        "steps": [
          "870° = 2·360° + 150°.",
          "sin870° = sin150° = sin(180° − 30°) = sin30° = <strong>1/2</strong>.",
          "cos870° = cos150° = cos(180° − 30°) = −cos30° = <strong>−√3/2</strong>."
        ]
      },
      {
        "caption": "2-masala · sin930° · 131-bet",
        "kirish": "930° burchakni keltiramiz.",
        "img": "png/2-masala.png",
        "alt": "2-masala: sin930 hisoblash, 131-bet",
        "width": 640,
        "height": 230,
        "steps": [
          "930° = 2·360° + 210° = 720° + 210°.",
          "sin930° = sin210° = sin(180° + 30°).",
          "III chorakda sinus manfiy: sin(180° + 30°) = −sin30° = <strong>−1/2</strong>."
        ]
      },
      {
        "caption": "3-masala · cos(15π/4) · 131-bet",
        "kirish": "Radiandagi burchakni keltiramiz.",
        "img": "png/3-masala.png",
        "alt": "3-masala: cos(15pi/4) hisoblash, 131-bet",
        "width": 640,
        "height": 120,
        "steps": [
          "15π/4 = 4π − π/4 = 2·2π − π/4.",
          "cos(15π/4) = cos(−π/4) = cos(π/4) = <strong>√2/2</strong>."
        ]
      },
      {
        "caption": "4-masala · tg(11π/6) va tg1050° · 132-bet",
        "kirish": "Tangens uchun keltirish formulalari.",
        "img": "png/4-masala.png",
        "alt": "4-masala: tg hisoblash, 132-bet",
        "width": 640,
        "height": 220,
        "steps": [
          "tg(11π/6) = tg(2π − π/6) = −tg(π/6) = <strong>−√3/3</strong>.",
          "tg1050° = tg(3·360° − 30°) = tg(−30°) = <strong>−√3/3</strong>."
        ]
      }
    ]
  },
